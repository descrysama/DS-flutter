# Port d'écoute de l'API
PORT=3000
# Fichier de la base SQLite (créé automatiquement)
DATABASE_PATH=data/database.sqlite
# Secret de signature des tokens JWT (générer une valeur longue et aléatoire)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Durée de validité des tokens
JWT_EXPIRES_IN=1h
# Nombre max de tentatives de connexion par IP sur 15 minutes
LOGIN_RATE_LIMIT=20
# (Optionnel) Servir directement en HTTPS
# SSL_KEY_PATH=./certs/key.pem
# SSL_CERT_PATH=./certs/cert.pem
